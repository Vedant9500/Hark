-- Paste into ~/.config/hypr/hyprland/rules.lua (replace the existing hark layer_rule).
--
-- Why: Hyprland blurs the full rectangular layer surface. ignore_alpha decides
-- which pixels frost: 0.8 sits above the card's AA edge (0.1-0.8) so corners
-- stay unblurred wallpaper while the 0.85 interior stays frosted, even at the
-- lowest opacity slider (0.40). Square corner BLOCKS are a different bug —
-- an outer CSS box-shadow clipped by the surface buffer (see
-- docs/hyprland-layer-corners.md); never fix those here.

-- Hark frosted glass: wiki https://wiki.hypr.land/Configuring/Basics/Window-Rules/
-- ignore_alpha ≤ threshold not blurred. 0.8 ignores AA 0.6-0.8 → corners fully
-- transparent (0), interior 0.85 still blurred. Low 0.05 blurred AA → square.
hl.layer_rule({
    match        = { namespace = "hark" },
    animation    = "popin 80%",
    blur         = true,
    ignore_alpha = 0.8,
    xray         = false,
})
